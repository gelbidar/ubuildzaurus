#!/bin/sh
rm -f /tmp/xo
/usr/bin/Xorg -config /etc/X11/xorg.conf -logfile /tmp/xo -verbose 4 :0 vt2 >/dev/null 2>&1 &
p=$!; sleep 6; kill "$p" 2>/dev/null; sleep 1; kill -9 "$p" 2>/dev/null; sleep 1
echo "===== Xorg errors ====="
grep -aE "\(EE\)|No devices|no screens|Fatal|not found" /tmp/xo | head -12
echo "===== end ====="
